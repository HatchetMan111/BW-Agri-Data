[Unit]
Description=heimgrund - Grundstueck-Check + Gartenplaner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heimgrund
Group=heimgrund
WorkingDirectory=/opt/heimgrund/app
Environment=DATA_DIR=/var/lib/heimgrund
Environment=APP_PORT=8000
ExecStart=/opt/heimgrund-venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
